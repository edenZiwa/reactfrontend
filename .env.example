# Optional API origin for donation checkout and donation status endpoints.
# Configure this only when the matching backend routes are deployed.
VITE_API_BASE_URL=/api
VITE_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY

# Comma-separated exact hostnames returned by the backend payment provider.
# Example: checkout.example-payments.com
# Configure the real provider hostname(s) in Cloudflare Pages build variables.
# Donation checkout redirects are blocked when this allowlist is empty.
VITE_PAYMENT_CHECKOUT_HOSTS=
